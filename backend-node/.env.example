# ── Base de données ───────────────────────────────────────────────────────
# ATTENTION : ce fichier est un EXEMPLE versionné — ne jamais mettre de vrais
# identifiants ici. Les valeurs réelles vont dans backend-node/.env (local)
# ou dans les Variables d'environnement Hostinger (production).
DATABASE_URL="mysql://UTILISATEUR:MOT_DE_PASSE@localhost:3306/NOM_BASE"
PORT=3001
HOST=0.0.0.0
APP_URL=https://votre-domaine.sn
FRONTEND_URL=https://votre-domaine.sn
TOKENABLE_TYPE=App\Models\User
# Dossier persistant pour les uploads (photos, pièces d'identité)
STORAGE_PATH=

# ── WhatsApp automatique (API Meta Cloud / WhatsApp Business) ─────────────
# https://developers.facebook.com → app → WhatsApp → Configuration de l'API.
# Sans ces valeurs, aucun envoi n'est tenté (repli : bouton wa.me admin).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
# Nom du template Meta approuvé — obligatoire en production pour joindre des
# numéros quelconques hors fenêtre de 24 h. Laisser vide = texte libre (mode test).
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=fr
# URL publique affichée dans les liens de suivi envoyés par WhatsApp.
APP_PUBLIC_URL=https://votre-domaine.sn
