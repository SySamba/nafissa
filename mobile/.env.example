# Copiez vers .env à la racine du dossier mobile/ et adaptez l’IP.
#
# Émulateur Android → PC Windows :
# EXPO_PUBLIC_API_URL=http://10.0.2.2:3001/api
#
# Téléphone sur le même Wi‑Fi que le PC (remplacez par l’IP de votre machine) :
# EXPO_PUBLIC_API_URL=http://192.168.1.xx:3001/api
#
# Après changement : redémarrer Metro avec cache vidé
#   npx expo start -c
#
# Pas d’ESPACE après http://

EXPO_PUBLIC_API_URL=http://127.0.0.1:3001/api
